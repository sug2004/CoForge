# Docker connection. Empty on Windows -> named pipe npipe:////./pipe/docker_engine
# Empty on Linux -> /var/run/docker.sock
DOCKER_HOST=

# Containers are NEVER auto-removed (no idle timeout / capacity eviction).
# They only go away when the owning session/project is deleted.
SANDBOX_CONTAINER_MEMORY_MB=2048   # per-container RAM (default 2048)
SANDBOX_CONTAINER_CPUS=2           # per-container CPUs (default 2)
# SANDBOX_WORKSPACE_ROOT= # default: os.tmpdir()/coforge-sandboxes

PORT=3004
