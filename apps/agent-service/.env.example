# NVIDIA NIM (https://build.nvidia.com) — OpenAI-compatible endpoint.
# GLM-5.2 Free API — get a key at https://build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used for every phase (planner / coder / memory / chat).
# Per-phase overrides: NVIDIA_PLANNER_MODEL, NVIDIA_CODER_MODEL,
# NVIDIA_MEMORY_MODEL, NVIDIA_CHAT_MODEL. Generic PLANNER_MODEL/CODER_MODEL/
# MEMORY_MODEL/CHAT_MODEL take precedence if set.
NVIDIA_MODEL=z-ai/glm-5.2

# Per-call LLM timeout in ms (planning/coding turn). Timeouts are retried.
# Default 300000 (5 min) if unset.
# LLM_TIMEOUT_MS=300000

# Min ms between consecutive LLM requests. The free tier rate-limits per minute,
# so calls are serialized and spaced out; a single agent run makes several calls
# in a row. 429s are also retried patiently (retry-after / up to 60s backoff).
# Default 1200 if unset. Set 0 to disable pacing.
# NVIDIA_MIN_REQUEST_GAP_MS=1200

# Service URLs
CORE_API_URL=http://localhost:3002
SYNC_SERVER_URL=http://localhost:3001
SANDBOX_RUNNER_URL=http://localhost:3004

# Auto-apply low-risk agent edits without human review
# AGENT_AUTO_APPLY=true
